{
  "name": "photo-collage",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "pnpm run prepare:compression-worker",
    "dev": "next dev",
